{
  "name": "observe-metrics",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS dashboard for tracking AI provider spend and usage across OpenAI, Anthropic, Google Gemini and more.",
  "scripts": {
    "dev": "next dev -p 3000",
    "worker": "node --experimental-strip-types worker/index.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cheerio": "^1.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "next": "^14.2.15",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "6.16.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3"
  }
}
