{
  "name": "observe-metrics",
  "version": "0.1.0",
  "private": true,
  "description": "ObserveMetrics — AI usage, cost & performance intelligence across OpenAI, Anthropic, Google Gemini and Mistral.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "worker": "node worker/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "geist": "^1.7.2",
    "ioredis": "^5.4.1",
    "lucide-react": "^1.48.0",
    "next": "^14.2.15",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "6.16.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
