# ──────────────────────────────────────────────────────────────
# ObserveMetrics — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# ──────────────────────────────────────────────────────────────

# ── Core (required) ──
# Public base URL of the app. Must be https:// in production (used for
# links in emails and the Google OAuth redirect URI).
APP_URL=http://localhost:3100

# PostgreSQL connection string (docker compose exposes 55432 locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/observe_metrics?schema=public

# 32-byte key for AES-256-GCM encryption of provider credentials, as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Losing it makes stored provider keys unrecoverable.
ENCRYPTION_KEY=
# Optional: previous key during rotation (secrets sealed with it stay readable).
ENCRYPTION_KEY_PREVIOUS=

# Shared secret for the scheduler endpoint (POST /api/v1/cron/tick).
# Required in production (24+ chars). In development, when unset, only
# localhost callers are accepted.
CRON_SECRET=

# ── Optional ──
# Redis for rate limiting shared across instances (falls back to in-memory).
REDIS_URL=redis://localhost:56379

# SMTP for password reset, invitations and alert emails. When unset, emails
# are printed to the server console in development and not sent in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ObserveMetrics <alerts@example.com>"

# Google sign-in. The "Continue with Google" button only appears when both are set.
# Authorized redirect URI: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo workspaces ("Explore demo data", anonymous "View demo"). Set to false to disable.
DEMO_MODE=true

# Worker interval (seconds) for `npm run worker`.
WORKER_INTERVAL_SECONDS=300

# Integration tests use a separate database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/observe_metrics_test?schema=public
